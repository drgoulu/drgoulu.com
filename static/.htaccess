# ----------------------------------------------------------------------
# Hugo Static Site Configuration for Apache (drgoulu.com)
# ----------------------------------------------------------------------

# Page d'erreur 404 personnalisée
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Rediriger www vers apex (drgoulu.com) en HTTPS (301 permanent)
  RewriteCond %{HTTP_HOST} ^www\.drgoulu\.com$ [NC]
  RewriteRule ^(.*)$ https://drgoulu.com/$1 [R=301,L]

  # 2. Forcer HTTPS (301 permanent)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://drgoulu.com/$1 [R=301,L]

  # 3. Redirection de /tags/x vers /tag/x
  RewriteRule ^tags/(.+)$ /tag/$1 [R=301,L]

  # 4. Redirection de /tag ou /tag/ vers /tags/ (index de tous les tags)
  RewriteRule ^tag/?$ /tags/ [R=301,L]
</IfModule>

# Types MIME modernes
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/xml .xml
  AddType application/json .json
  AddType text/css .css
  AddType application/javascript .js
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

# ----------------------------------------------------------------------
# Cache navigateur (Core Web Vitals & Performance)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML / XML / JSON : validation immédiate pour mise à jour rapide
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/rss+xml "access plus 1 hour"

  # CSS et JavaScript : 1 an
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Polices web : 1 an
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"

  # Images et médias : 1 an
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Cache-Control pour les assets statiques
  <FilesMatch "\.(css|js|woff|woff2|ttf|otf|webp|avif|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # Sveltia CMS bundle : pas de cache agressif pour permettre les mises à jour immédiates
  <FilesMatch "^sveltia-cms">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # HTML et flux RSS revalidés
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Découverte d'agents IA (RFC 8288 & RFC 9727)
  <FilesMatch "\.html$">
    Header set Link "</.well-known/api-catalog>; rel=\"api-catalog\""
  </FilesMatch>
  SetEnvIf Request_URI "^/(index\.html)?$" AGENT_DISCOVERY=1
  Header set Link "</.well-known/api-catalog>; rel=\"api-catalog\"" env=AGENT_DISCOVERY

  # Sécurité
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Type MIME pour le catalogue d'API agent (RFC 9727)
<Files "api-catalog">
  ForceType "application/linkset+json; charset=utf-8"
</Files>
