{
  "name": "hugo-blox-blog-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Blog starter template for Hugo Blox with Tailwind CSS v4",
  "scripts": {
    "dev": "pnpm run backlinks && hugo server --disableFastRender",
    "dev:sveltia": "./scripts/dev-sveltia.sh",
    "dev:sveltia:pagefind": "./scripts/dev-sveltia.sh --pagefind",
    "backlinks": "go run github.com/drgoulu/backlinks4hugo",
    "build": "pnpm run backlinks && hugo --cleanDestinationDir --gc --minify && pnpm run pagefind",
    "pagefind": "pagefind --site public"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  }
}
